generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ORGANIZATION / SAAS FOUNDATION
// ============================================================

model Organization {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  logo String?

  users           User[]
  teamMembers     TeamMember[]
  services        Service[]
  projects        Project[]
  events          Event[]
  eventSeries     EventSeries[]
  websiteSettings WebsiteSetting[]
  media           Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// USERS / AUTHENTICATION
// ============================================================

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  role Role @default(STAFF)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  OWNER
  CO_OWNER
  ADMIN
  MANAGER
  STAFF
}

// ============================================================
// COMPANY TEAM MEMBERS
// ============================================================

enum Department {
  MANAGEMENT
  ESPORTS
  BROADCAST
  PRODUCTION
  MEDIA
  MARKETING
}

enum TeamPosition {
  OWNER
  CO_OWNER
  MANAGER
  OBSERVER
  CASTER
  HOST
  CAMERA_OPERATOR
  GRAPHICS_OPERATOR
  VIDEO_EDITOR
  SOCIAL_MEDIA_MANAGER
  TOURNAMENT_ADMIN
  REFEREE
}

model TeamMember {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fullName String
  nickname String?

  position   TeamPosition
  department Department

  bio          String?
  profileImage String?

  facebook  String?
  instagram String?
  youtube   String?
  discord   String?

  phone String?
  email String?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// SERVICES
// ============================================================

model Service {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title            String
  slug             String
  shortDescription String?
  description      String?

  image String?
  icon  String?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  featured     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title String
  slug  String

  shortDescription String?
  description      String?

  coverImage String?

  client   String?
  category String?

  projectDate DateTime?

  projectUrl String?

  featured     Boolean @default(false)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ============================================================
// EVENTS / PORTFOLIO SHOWCASE
// ============================================================

model EventSeries {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  description String?
  coverImage  String?

  isActive     Boolean @default(true)
  featured     Boolean @default(false)
  displayOrder Int     @default(0)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Event {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventSeriesId String?
  eventSeries   EventSeries? @relation(fields: [eventSeriesId], references: [id], onDelete: SetNull)

  title String
  slug  String

  shortDescription String?
  description      String?

  coverImage String?

  category  String?
  client    String?
  organizer String?
  location  String?

  eventDate DateTime

  eventUrl String?

  featured     Boolean @default(false)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  photos   EventPhoto[]
  videos   EventVideo[]
  timeline EventTimeline[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([eventSeriesId])
  @@index([eventDate])
  @@index([isActive])
  @@index([featured])
}

// ============================================================
// EVENT PHOTO GALLERY
// ============================================================

model EventPhoto {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String?
  description String?

  imageUrl     String
  thumbnailUrl String?

  featured     Boolean @default(false)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([isActive])
  @@index([featured])
}

// ============================================================
// EVENT VIDEO GALLERY
// ============================================================

enum EventVideoPlatform {
  YOUTUBE
  FACEBOOK
  VIMEO
  OTHER
}

model EventVideo {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?

  platform EventVideoPlatform

  videoUrl     String
  thumbnailUrl String?

  featured     Boolean @default(false)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([platform])
  @@index([isActive])
  @@index([featured])
}

// ============================================================
// EVENT TIMELINE
// ============================================================

model EventTimeline {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?

  timelineDate DateTime

  imageUrl String?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  featured     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([timelineDate])
  @@index([isActive])
}

// ============================================================
// TOURNAMENT SYSTEM
// ============================================================

enum TournamentGame {
  PUBG_MOBILE
  FREE_FIRE
  VALORANT
  CS2
  DOTA2
  EA_FC
  EFOOTBALL
  MOBILE_LEGENDS
  OTHER
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  LIVE
  COMPLETED
  CANCELLED
}

model Tournament {
  id   String         @id @default(cuid())
  name String
  slug String         @unique
  game TournamentGame

  logo        String?
  banner      String?
  description String?
  rules       String?

  organizer       String
  registrationFee Float   @default(0)
  prizePool       String?

  maxTeams     Int
  currentTeams Int @default(0)

  registrationOpen  DateTime
  registrationClose DateTime

  tournamentStart DateTime
  tournamentEnd   DateTime

  discordUrl  String?
  whatsappUrl String?
  streamUrl   String?
  websiteUrl  String?

  featured Boolean @default(false)
  isPublic Boolean @default(true)

  status TournamentStatus @default(DRAFT)

  registrations Registration[]
  matches       Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// REGISTRATIONS
// ============================================================

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLIST
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

model Registration {
  id           String @id @default(cuid())
  tournamentId String

  teamName String
  teamLogo String?

  captainName  String
  captainEmail String
  captainPhone String

  managerName  String?
  managerPhone String?

  discordUsername String?

  gameUID    String
  gameIGN    String
  rosterSize Int

  paymentStatus      PaymentStatus      @default(UNPAID)
  registrationStatus RegistrationStatus @default(PENDING)

  remarks String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// TOURNAMENT TEAMS
// ============================================================

enum TeamStatus {
  ACTIVE
  ELIMINATED
  DISQUALIFIED
  WITHDRAWN
}

model Team {
  id             String @id @default(cuid())
  registrationId String @unique

  teamName String
  teamLogo String?

  status TeamStatus @default(ACTIVE)

  wins   Int @default(0)
  losses Int @default(0)
  points Int @default(0)
  kills  Int @default(0)

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  players Player[]

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PLAYERS
// ============================================================

enum PlayerRole {
  CAPTAIN
  PLAYER
  SUBSTITUTE
  COACH
  MANAGER
}

model Player {
  id     String @id @default(cuid())
  teamId String

  fullName   String
  inGameName String
  gameUID    String

  role PlayerRole @default(PLAYER)

  country     String?
  nationality String?

  profileImage String?
  isActive     Boolean @default(true)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// MATCHES
// ============================================================

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum MatchType {
  BO1
  BO3
  BO5
  CUSTOM
}

model Match {
  id           String @id @default(cuid())
  tournamentId String

  homeTeamId   String
  awayTeamId   String
  winnerTeamId String?

  title String
  round String?

  matchType MatchType   @default(BO1)
  status    MatchStatus @default(SCHEDULED)

  scheduledAt DateTime

  homeScore Int @default(0)
  awayScore Int @default(0)

  notes String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// MEDIA / GALLERY
// ============================================================

enum MediaPlatform {
  FACEBOOK
  YOUTUBE
  IMAGE
  VIDEO
}

model Media {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?

  platform MediaPlatform

  sourceUrl    String
  thumbnailUrl String?

  category String?

  featured     Boolean @default(false)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([platform])
  @@index([category])
  @@index([isActive])
}

// ============================================================
// WEBSITE SETTINGS
// ============================================================

model WebsiteSetting {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyName String
  tagline     String?

  logo    String?
  favicon String?

  email          String?
  phone          String?
  alternatePhone String?

  address String?
  city    String?
  country String?

  website String?

  facebook  String?
  instagram String?
  youtube   String?
  discord   String?
  tiktok    String?
  linkedin  String?

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  footerText    String?
  copyrightText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
